# at2s db-access 连接配置模板
# 使用方式：复制本文件为同目录的 .env 并填写 PGPASSWORD 后即可运行 scripts/pg_query.py
# （.env 已被 gitignore，不会进入版本库；本 .env.example 例外，可安全提交）
# 也可直接以同名环境变量提供上述参数，脚本中已存在的环境变量优先于 .env

# 连接配置（新克隆据此即可知道该连到哪里）
PGHOST=47.94.129.195
PGPORT=5432
PGDATABASE=root
PGUSER=read

# 凭据：只读账户密码，由团队内部共享，请勿提交到仓库
PGPASSWORD=<请填写只读账户 read 的密码>

# 可选：服务端不做 TLS 协商，默认 disable 即可；如需变更在此覆盖
PGSSLMODE=disable
