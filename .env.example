# Copy this file to .env and fill in local credentials.
PGHOST=your-postgresql-host
PGPORT=5432
PGDATABASE=your-database
PGUSER=your-readonly-user
PGPASSWORD=replace-with-local-password
PGSSLMODE=prefer
PGCLIENTENCODING=UTF8
PGRESULT_ENCODING=utf-8
PGCONNECT_TIMEOUT=10
PGSTATEMENT_TIMEOUT_MS=30000

# OpenAI-compatible Chat Completions API used by run_text2sql.ps1.
LLM_BASE_URL=https://your-openai-compatible-host/v1
LLM_API_KEY=replace-with-local-api-key
LLM_MODEL=replace-with-model-name
LLM_TIMEOUT_SECONDS=120
